# ==============================================================
# ALMAE DIGITAL — Variables de entorno de PRODUCCIÓN (PLANTILLA)
# --------------------------------------------------------------
# Copiar al panel del hosting (Vercel > Project > Settings >
# Environment Variables) con los valores reales.
# NUNCA versionar valores reales. NUNCA exponer la service role.
# ==============================================================

# --- Aplicación ------------------------------------------------
# Dominio definitivo, sin barra final. Fijar también en el DNS.
NEXT_PUBLIC_SITE_URL=https://www.almae.pe
# OBLIGATORIO: production deshabilita la cuenta demo y los avisos locales
NEXT_PUBLIC_ENV=production

# --- Supabase (Supabase Cloud > Project Settings > API) -------
# URL del proyecto remoto (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Clave anon: segura de exponer; RLS la limita
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO server-side. Jamás en NEXT_PUBLIC_* ni en el navegador
SUPABASE_SERVICE_ROLE_KEY=

# --- Negocio ---------------------------------------------------
# Zona horaria fija (no cambiar)
APP_TIMEZONE=America/Lima
# Retención HELD efectiva: se configura en business_settings (admin).
# Debe permanecer en 15 minutos (booking_hold_ttl_minutes = 15).
BOOKING_HOLD_TTL_MINUTES=15
# Gap mínimo entre citas (valor inicial; editable en admin)
BOOKING_GAP_MINUTES=15

# --- Pagos -----------------------------------------------------
# Producción sin pagos web: mantener mock y sin llaves.
# Habilitar pagos solo con autorización explícita del propietario.
PAYMENTS_PROVIDER=mock
PAYMENTS_MOCK_AUTO_SUCCESS=false
PAYMENTS_MOCK_WEBHOOK_SECRET=
# CULQI_* solo si se autoriza habilitar pagos (server-side)
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=

# --- Cron / mantenimiento --------------------------------------
# Secreto Bearer del endpoint /api/cron/expire-holds.
# Generar con: openssl rand -hex 32  (guardarlo solo en el hosting)
CRON_SECRET=

# --- WhatsApp --------------------------------------------------
# Número público en formato internacional sin + (opcional)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Redes sociales (opcional) ---------------------------------
# Formato: "Etiqueta|URL" separado por comas
NEXT_PUBLIC_SOCIAL_LINKS=

# --- Rate limiting distribuido (opcional, sin costo inicial) ---
# Con las variables definidas, el límite pasa de memoria por instancia
# a Upstash Redis (plan gratuito suficiente para el tráfico actual).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
