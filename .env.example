# ==============================================================
# ALMAE DIGITAL — Variables de entorno (PLANTILLA)
# --------------------------------------------------------------
# Copiar a .env.local y completar con valores reales.
# NUNCA versionar .env.local. Nada de valores reales en este archivo.
# ==============================================================

# --- Aplicación ------------------------------------------------
# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Entorno de ejecución: development | preview | production
NEXT_PUBLIC_ENV=development

# --- Supabase --------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon). Segura de exponer: RLS la limita.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO server-side. Jamás exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Negocio ---------------------------------------------------
# Zona horaria fija del sistema (no cambiar)
APP_TIMEZONE=America/Lima
# Minutos de vigencia de una reserva temporal (hold)
BOOKING_HOLD_TTL_MINUTES=10
# Buffer mínimo entre citas, en minutos (valor inicial, editable en admin)
BOOKING_GAP_MINUTES=15

# --- Pagos -----------------------------------------------------
# Proveedor activo: mock (desarrollo) | culqi (sandbox/producción)
PAYMENTS_PROVIDER=mock
# Culqi — llave pública (segura para frontend, sandbox)
CULQI_PUBLIC_KEY=
# Culqi — llave secreta. SOLO server-side. Sandbox primero.
CULQI_SECRET_KEY=
# Culqi — secreto para validar firmas de webhooks (según docs vigentes)
CULQI_WEBHOOK_SECRET=
# Modo simulador de pagos: se ignora si PAYMENTS_PROVIDER != mock
PAYMENTS_MOCK_AUTO_SUCCESS=false

# --- Cron / mantenimiento --------------------------------------
# Secreto para el endpoint interno de expiración de holds (CRON)
CRON_SECRET=

# --- WhatsApp --------------------------------------------------
# Número público de WhatsApp Business en formato internacional sin +
# Si se deja vacío, se usa el número público autorizado de ALMAE (51 919 608 174)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Rate limiting (opcional en desarrollo) --------------------
# Si se define, se usa Upstash Redis; si no, límite en memoria por instancia
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
